{
  "name": "arcforge-docs-site",
  "scripts": {
    "docs:build": "node scripts/docs-site/build.mjs && pagefind --site dist/docs-site --output-path dist/docs-site/pagefind",
    "docs:smoke": "node scripts/docs-site/smoke.mjs",
    "docs:check": "npm run docs:build && npm run docs:smoke",
    "docs:serve": "python3 -m http.server 4173 --bind 127.0.0.1 -d dist/docs-site",
    "test": "node --test scripts/docs-site/*.test.mjs"
  },
  "devDependencies": {
    "highlight.js": "11.11.1",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "9.2.0",
    "mermaid": "11.12.0",
    "pagefind": "1.4.0",
    "yaml": "2.8.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
